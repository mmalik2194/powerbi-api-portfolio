{
  "name": "Solar_Weather_Intelligence",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "expressions": [
      {
        "name": "UseLiveAPI",
        "kind": "m",
        "expression": "false meta [IsParameterQuery=true, Type=\"Logical\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "DimCity",
        "columns": [
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "City",
            "summarizeBy": "none"
          },
          {
            "name": "Latitude",
            "dataType": "double",
            "sourceColumn": "Latitude",
            "summarizeBy": "none"
          },
          {
            "name": "Longitude",
            "dataType": "double",
            "sourceColumn": "Longitude",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimCity",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source=Csv.Document(Binary.FromText(\"Q2l0eSxMYXRpdHVkZSxMb25naXR1ZGUKU3lkbmV5LC0zMy44Njg4LDE1MS4yMDkzCk1lbGJvdXJuZSwtMzcuODEzNiwxNDQuOTYzMQpCcmlzYmFuZSwtMjcuNDY5OCwxNTMuMDI1MQpQZXJ0aCwtMzEuOTUyMywxMTUuODYxMwpBZGVsYWlkZSwtMzQuOTI4NSwxMzguNjAwNwo=\",BinaryEncoding.Base64),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Nulls=Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed=Table.TransformColumnTypes(Nulls,{{\"City\",type text},{\"Latitude\",type number},{\"Longitude\",type number}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "DimDate",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd",
            "isKey": true
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "MonthNumber",
            "dataType": "int64",
            "sourceColumn": "MonthNumber",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "sortByColumn": "MonthNumber"
          },
          {
            "name": "YearMonth",
            "dataType": "string",
            "sourceColumn": "YearMonth",
            "summarizeBy": "none",
            "sortByColumn": "YearMonthNumber"
          },
          {
            "name": "YearMonthNumber",
            "dataType": "int64",
            "sourceColumn": "YearMonthNumber",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "WeekdayNumber",
            "dataType": "int64",
            "sourceColumn": "WeekdayNumber",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Weekday",
            "dataType": "string",
            "sourceColumn": "Weekday",
            "summarizeBy": "none",
            "sortByColumn": "WeekdayNumber"
          },
          {
            "name": "Quarter",
            "dataType": "int64",
            "sourceColumn": "Quarter",
            "summarizeBy": "none",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source=Csv.Document(Binary.FromText(\"\",BinaryEncoding.Base64),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Nulls=Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed=Table.TransformColumnTypes(Nulls,{{\"Date\",type date},{\"Year\",Int64.Type},{\"MonthNumber\",Int64.Type},{\"Month\",type text},{\"YearMonth\",type text},{\"YearMonthNumber\",Int64.Type},{\"WeekdayNumber\",Int64.Type},{\"Weekday\",type text},{\"Quarter\",Int64.Type}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "Capacity",
        "columns": [
          {
            "name": "CapacitykWp",
            "dataType": "int64",
            "sourceColumn": "CapacitykWp",
            "summarizeBy": "none",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Capacity",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source=Csv.Document(Binary.FromText(\"Q2FwYWNpdHlrV3AKMjUKNTAKMTAwCjI1MAo1MDAK\",BinaryEncoding.Base64),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Nulls=Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed=Table.TransformColumnTypes(Nulls,{{\"CapacitykWp\",Int64.Type}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "PerformanceRatio",
        "columns": [
          {
            "name": "PRPercent",
            "dataType": "int64",
            "sourceColumn": "PRPercent",
            "summarizeBy": "none",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "PerformanceRatio",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source=Csv.Document(Binary.FromText(\"UFJQZXJjZW50CjY1CjcwCjc1CjgwCjg1CjkwCg==\",BinaryEncoding.Base64),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Nulls=Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed=Table.TransformColumnTypes(Nulls,{{\"PRPercent\",Int64.Type}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "RainThreshold",
        "columns": [
          {
            "name": "MM",
            "dataType": "int64",
            "sourceColumn": "MM",
            "summarizeBy": "none",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "RainThreshold",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source=Csv.Document(Binary.FromText(\"TU0KNQoxMAoxNQoyMAoyNQo=\",BinaryEncoding.Base64),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Nulls=Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed=Table.TransformColumnTypes(Nulls,{{\"MM\",Int64.Type}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "FactWeather",
        "columns": [
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "City",
            "summarizeBy": "none"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "SolarKWhM2",
            "dataType": "double",
            "sourceColumn": "SolarKWhM2",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "MaxTempC",
            "dataType": "double",
            "sourceColumn": "MaxTempC",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "MinTempC",
            "dataType": "double",
            "sourceColumn": "MinTempC",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "RainMM",
            "dataType": "double",
            "sourceColumn": "RainMM",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "WindMS",
            "dataType": "double",
            "sourceColumn": "WindMS",
            "summarizeBy": "none",
            "formatString": "0.0"
          }
        ],
        "partitions": [
          {
            "name": "FactWeather",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "if UseLiveAPI then",
                "(let",
                " FetchCity=(r)=>let",
                "  Source=Json.Document(Web.Contents(\"https://power.larc.nasa.gov\",[RelativePath=\"api/temporal/daily/point\",Query=[parameters=\"ALLSKY_SFC_SW_DWN,T2M_MAX,T2M_MIN,PRECTOTCORR,WS10M\",community=\"RE\",longitude=Text.From(r[Longitude],\"en-US\"),latitude=Text.From(r[Latitude],\"en-US\"),start=\"20200101\",end=\"20251231\",format=\"JSON\",#\"time-standard\"=\"LST\"],Timeout=#duration(0,0,3,0)])),",
                "  P=Source[properties][parameter],Fill=Source[header][fill_value],Keys=Record.FieldNames(P[ALLSKY_SFC_SW_DWN]),",
                "  Value=(param,key)=>let V=Record.FieldOrDefault(Record.Field(P,param),key,null) in if V=Fill then null else V,",
                "  Rows=List.Transform(Keys,each [City=r[City],Date=Date.FromText(Text.Start(_,4)&\"-\"&Text.Middle(_,4,2)&\"-\"&Text.End(_,2)),SolarKWhM2=Value(\"ALLSKY_SFC_SW_DWN\",_),MaxTempC=Value(\"T2M_MAX\",_),MinTempC=Value(\"T2M_MIN\",_),RainMM=Value(\"PRECTOTCORR\",_),WindMS=Value(\"WS10M\",_)]),T=Table.FromRecords(Rows)",
                " in T,",
                " Combined=Table.Combine(List.Transform(Table.ToRecords(DimCity),each FetchCity(_))),",
                " Typed=Table.TransformColumnTypes(Combined,{{\"City\",type text},{\"Date\",type date},{\"SolarKWhM2\",type number},{\"MaxTempC\",type number},{\"MinTempC\",type number},{\"RainMM\",type number},{\"WindMS\",type number}})",
                "in Typed)",
                "else",
                "(let",
                " Source=Csv.Document(Binary.FromText(\"\",BinaryEncoding.Base64),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Nulls=Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed=Table.TransformColumnTypes(Nulls,{{\"City\",type text},{\"Date\",type date},{\"SolarKWhM2\",type number},{\"MaxTempC\",type number},{\"MinTempC\",type number},{\"RainMM\",type number},{\"WindMS\",type number}},\"en-US\")",
                "in Typed)"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Capacity kWp",
            "expression": "SELECTEDVALUE(Capacity[CapacitykWp],100)",
            "formatString": "#,0\" kWp\"",
            "displayFolder": "Controls"
          },
          {
            "name": "Performance Ratio",
            "expression": "DIVIDE(SELECTEDVALUE(PerformanceRatio[PRPercent],80),100)",
            "formatString": "0%",
            "displayFolder": "Controls"
          },
          {
            "name": "Rain Threshold",
            "expression": "SELECTEDVALUE(RainThreshold[MM],10)",
            "formatString": "0\" mm\"",
            "displayFolder": "Controls"
          },
          {
            "name": "City Days",
            "expression": "COUNTROWS(FactWeather)",
            "formatString": "#,0",
            "displayFolder": "Base"
          },
          {
            "name": "Observed Solar Days",
            "expression": "COUNT(FactWeather[SolarKWhM2])",
            "formatString": "#,0",
            "displayFolder": "Data quality"
          },
          {
            "name": "Solar Coverage",
            "expression": "DIVIDE([Observed Solar Days],[City Days])",
            "formatString": "0.0%",
            "displayFolder": "Data quality"
          },
          {
            "name": "Mean Daily Solar",
            "expression": "AVERAGE(FactWeather[SolarKWhM2])",
            "formatString": "0.00",
            "displayFolder": "Base"
          },
          {
            "name": "Rainfall Total",
            "expression": "SUM(FactWeather[RainMM])",
            "formatString": "#,0.0",
            "displayFolder": "Base"
          },
          {
            "name": "Mean Max Temperature",
            "expression": "AVERAGE(FactWeather[MaxTempC])",
            "formatString": "0.0\" °C\"",
            "displayFolder": "Base"
          },
          {
            "name": "Scenario Energy kWh",
            "expression": "SUM(FactWeather[SolarKWhM2])*[Capacity kWp]*[Performance Ratio]",
            "formatString": "#,0",
            "displayFolder": "Scenario"
          },
          {
            "name": "Scenario Energy MWh",
            "expression": "DIVIDE([Scenario Energy kWh],1000)",
            "formatString": "#,0.0\" MWh\"",
            "displayFolder": "Scenario"
          },
          {
            "name": "Energy Prior Year",
            "expression": "CALCULATE([Scenario Energy kWh],DATEADD(DimDate[Date],-1,YEAR))",
            "formatString": "#,0",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Energy YoY Pct",
            "expression": "IF(HASONEVALUE(DimDate[Year]),DIVIDE([Scenario Energy kWh]-[Energy Prior Year],[Energy Prior Year]))",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Energy YTD kWh",
            "expression": "IF(HASONEVALUE(DimDate[Year]),TOTALYTD([Scenario Energy kWh],DimDate[Date]))",
            "formatString": "#,0",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Energy Rolling 30D",
            "expression": "VAR D=MAX(DimDate[Date]) RETURN CALCULATE([Scenario Energy kWh],REMOVEFILTERS(DimDate),DATESINPERIOD(DimDate[Date],D,-30,DAY))",
            "formatString": "#,0",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Adverse City Days",
            "expression": "VAR R=[Rain Threshold] RETURN COUNTROWS(FILTER(FactWeather,(NOT ISBLANK(FactWeather[RainMM])&&FactWeather[RainMM]>=R)||(NOT ISBLANK(FactWeather[MaxTempC])&&FactWeather[MaxTempC]>=35)||(NOT ISBLANK(FactWeather[WindMS])&&FactWeather[WindMS]>=10)))",
            "formatString": "#,0",
            "displayFolder": "Scenario"
          },
          {
            "name": "Adverse Day Share",
            "expression": "DIVIDE([Adverse City Days],[City Days])",
            "formatString": "0.0%",
            "displayFolder": "Scenario"
          },
          {
            "name": "Solar Rank",
            "expression": "RANKX(ALLSELECTED(DimCity[City]),[Mean Daily Solar],,DESC,DENSE)",
            "formatString": "0",
            "displayFolder": "Benchmarking"
          },
          {
            "name": "Network Mean Solar",
            "expression": "CALCULATE([Mean Daily Solar],REMOVEFILTERS(DimCity))",
            "formatString": "0.00",
            "displayFolder": "Benchmarking"
          },
          {
            "name": "Solar Gap vs Network",
            "expression": "[Mean Daily Solar]-[Network Mean Solar]",
            "formatString": "+0.00;-0.00;0.00",
            "displayFolder": "Benchmarking"
          },
          {
            "name": "Historical Monthly Baseline",
            "expression": "VAR M=SELECTEDVALUE(DimDate[MonthNumber]) RETURN IF(NOT ISBLANK(M),CALCULATE([Mean Daily Solar],REMOVEFILTERS(DimDate),DimDate[MonthNumber]=M,DimDate[Year]>=2020,DimDate[Year]<=2024))",
            "formatString": "0.00",
            "displayFolder": "Benchmarking"
          },
          {
            "name": "Solar Anomaly Pct",
            "expression": "DIVIDE([Mean Daily Solar]-[Historical Monthly Baseline],[Historical Monthly Baseline])",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Benchmarking"
          },
          {
            "name": "Duplicate City Dates",
            "expression": "COUNTROWS(FactWeather)-COUNTROWS(SUMMARIZE(FactWeather,FactWeather[City],FactWeather[Date]))",
            "formatString": "0",
            "displayFolder": "Data quality"
          },
          {
            "name": "Missing Solar Values",
            "expression": "[City Days]-[Observed Solar Days]",
            "formatString": "#,0",
            "displayFolder": "Data quality"
          },
          {
            "name": "Scenario Caption",
            "expression": "\"Illustrative equal-size systems: \" & FORMAT([Capacity kWp],\"#,0\") & \" kWp per city × \" & FORMAT([Performance Ratio],\"0%\") & \" performance ratio\"",
            "formatString": "General",
            "displayFolder": "Narrative"
          },
          {
            "name": "Energy Chart Title",
            "expression": "\"Monthly scenario energy (kWh) | \" & FORMAT([Capacity kWp],\"#,0\") & \" kWp per selected city\"",
            "formatString": "General",
            "displayFolder": "Narrative"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "e2cdce4a-d961-4608-af68-5a31d08a1bca",
        "fromTable": "FactWeather",
        "fromColumn": "City",
        "toTable": "DimCity",
        "toColumn": "City",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "1d6baea7-1f5b-4df5-836a-24dc9b10eb91",
        "fromTable": "FactWeather",
        "fromColumn": "Date",
        "toTable": "DimDate",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "annotations": [
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DimCity\", \"DimDate\", \"Capacity\", \"PerformanceRatio\", \"RainThreshold\", \"FactWeather\"]"
      }
    ]
  }
}