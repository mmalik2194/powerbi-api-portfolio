      {
        "name": "FactDevelopment",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "ISO3",
            "dataType": "string",
            "lineageTag": "6ec4ebd5-37c5-4af3-91ba-416cdbf1b8bd",
            "sourceColumn": "ISO3",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "formatString": "0",
            "lineageTag": "ea34bcc3-8b09-4fc9-afc1-75afc2d220c3",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "Population",
            "dataType": "int64",
            "formatString": "#,0",
            "lineageTag": "86daa501-7626-43f8-ae39-f08db256840f",
            "sourceColumn": "Population",
            "summarizeBy": "none"
          },
          {
            "name": "LifeExpectancy",
            "dataType": "double",
            "formatString": "0.0",
            "lineageTag": "97521fee-36e2-4214-9fd8-27c47261ec31",
            "sourceColumn": "LifeExpectancy",
            "summarizeBy": "none"
          },
          {
            "name": "GDPperCapitaPPP",
            "dataType": "double",
            "formatString": "#,0",
            "lineageTag": "f68af760-33de-4f21-a970-d9aedb4199b3",
            "sourceColumn": "GDPperCapitaPPP",
            "summarizeBy": "none"
          },
          {
            "name": "UnemploymentPct",
            "dataType": "double",
            "formatString": "0.0",
            "lineageTag": "303b8678-c883-4680-bcd6-06ef703376df",
            "sourceColumn": "UnemploymentPct",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "4b40dfa0-eba3-4a27-a8b4-1c070da40a26",
        "measures": [
          {
            "name": "Report Year",
            "displayFolder": "Controls",
            "expression": "SELECTEDVALUE(AsOfYear[Year], MAX(AsOfYear[Year]))",
            "formatString": "0",
            "lineageTag": "0677f0c7-5f5c-4879-9f22-4ce8531b2282"
          },
          {
            "name": "Metric Name",
            "displayFolder": "Controls",
            "expression": "SELECTEDVALUE(MetricSelector[Metric], \"Life expectancy\")",
            "formatString": "General",
            "lineageTag": "3e992e39-0fb8-4444-b0e0-1601b574fd98"
          },
          {
            "name": "Top N",
            "displayFolder": "Controls",
            "expression": "SELECTEDVALUE(RankControl[Count],10)",
            "formatString": "0",
            "lineageTag": "3cc7f279-b5b4-4cf6-a33e-d2c443168ae6"
          },
          {
            "name": "Total Population",
            "displayFolder": "Base measures",
            "expression": "IF(HASONEVALUE(DimYear[Year]),SUM(FactDevelopment[Population]))",
            "formatString": "#,0",
            "lineageTag": "34b22f73-a735-4248-a3ef-5fe1271ae289"
          },
          {
            "name": "Life Expectancy",
            "displayFolder": "Base measures",
            "expression": "VAR R = FILTER(FactDevelopment, NOT ISBLANK(FactDevelopment[LifeExpectancy]) && FactDevelopment[Population] > 0) RETURN IF(HASONEVALUE(DimYear[Year]), DIVIDE(SUMX(R,FactDevelopment[Population]*FactDevelopment[LifeExpectancy]), SUMX(R,FactDevelopment[Population])))",
            "formatString": "0.0",
            "lineageTag": "eb39a60b-8505-4c6c-9eee-dbb0981c96ba"
          },
          {
            "name": "GDP PPP per Capita",
            "displayFolder": "Base measures",
            "expression": "VAR R = FILTER(FactDevelopment, NOT ISBLANK(FactDevelopment[GDPperCapitaPPP]) && FactDevelopment[Population] > 0) RETURN IF(HASONEVALUE(DimYear[Year]), DIVIDE(SUMX(R,FactDevelopment[Population]*FactDevelopment[GDPperCapitaPPP]), SUMX(R,FactDevelopment[Population])))",
            "formatString": "#,0",
            "lineageTag": "066dd689-812c-43e6-8e99-956cbca9f75d"
          },
          {
            "name": "Unemployment",
            "displayFolder": "Base measures",
            "expression": "IF(HASONEVALUE(DimYear[Year]), AVERAGE(FactDevelopment[UnemploymentPct]))",
            "formatString": "0.0",
            "lineageTag": "fc7ace67-45a3-4a42-903b-547b178cfe93"
          },
          {
            "name": "Selected Metric",
            "displayFolder": "Metric switch",
            "expression": "SWITCH([Metric Name],\"GDP PPP per capita\",[GDP PPP per Capita],\"Unemployment rate\",[Unemployment],[Life Expectancy])",
            "formatString": "#,0.0",
            "lineageTag": "2328afe0-f626-48d0-93b8-f10f133fabf6"
          },
          {
            "name": "Snapshot Metric",
            "displayFolder": "Snapshot",
            "expression": "VAR Y=[Report Year] RETURN CALCULATE([Selected Metric],REMOVEFILTERS(DimYear),DimYear[Year]=Y)",
            "formatString": "#,0.0",
            "lineageTag": "09bf96ff-c6e7-449a-8f3e-8a196b0f477d"
          },
          {
            "name": "Snapshot Population",
            "displayFolder": "Snapshot",
            "expression": "VAR Y=[Report Year] RETURN DIVIDE(CALCULATE([Total Population],REMOVEFILTERS(DimYear),DimYear[Year]=Y),1000000000)",
            "formatString": "0.00\" bn\"",
            "lineageTag": "c795458f-be4d-44f6-bffc-b63eccbcf58b"
          },
          {
            "name": "Snapshot Life",
            "displayFolder": "Snapshot",
            "expression": "VAR Y=[Report Year] RETURN CALCULATE([Life Expectancy],REMOVEFILTERS(DimYear),DimYear[Year]=Y)",
            "formatString": "0.0\" yrs\"",
            "lineageTag": "13b0f08f-0536-43f9-a108-421f69c8ffe9"
          },
          {
            "name": "Snapshot GDP",
            "displayFolder": "Snapshot",
            "expression": "VAR Y=[Report Year] RETURN CALCULATE([GDP PPP per Capita],REMOVEFILTERS(DimYear),DimYear[Year]=Y)",
            "formatString": "#,0",
            "lineageTag": "c96dc9ba-f79f-43a3-b63a-7af9341b2edf"
          },
          {
            "name": "Previous Year Metric",
            "displayFolder": "Comparisons",
            "expression": "VAR Y=[Report Year]-1 RETURN CALCULATE([Selected Metric],REMOVEFILTERS(DimYear),DimYear[Year]=Y)",
            "formatString": "#,0.0",
            "lineageTag": "29d3713d-6775-45bf-9db6-bd1e848cba33"
          },
          {
            "name": "YoY Change",
            "displayFolder": "Comparisons",
            "expression": "VAR P=[Previous Year Metric] RETURN IF(NOT ISBLANK(P) && NOT ISBLANK([Snapshot Metric]),[Snapshot Metric]-P)",
            "formatString": "+0.0;-0.0;0.0",
            "lineageTag": "940d2d0d-bca4-4ffd-81ed-b012e3378dc2"
          },
          {
            "name": "YoY Change Pct",
            "displayFolder": "Comparisons",
            "expression": "DIVIDE([YoY Change],[Previous Year Metric])",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "b1f892c2-c0ff-4522-b40c-9461f2356d4d"
          },
          {
            "name": "Peer Benchmark",
            "displayFolder": "Comparisons",
            "expression": "VAR R=SELECTEDVALUE(DimCountry[Region]) RETURN CALCULATE([Snapshot Metric],FILTER(ALL(DimCountry),ISBLANK(R)||DimCountry[Region]=R))",
            "formatString": "#,0.0",
            "lineageTag": "79b02751-1451-4fd7-b389-ac56764eadd0"
          },
          {
            "name": "Gap vs Peers",
            "displayFolder": "Comparisons",
            "expression": "IF(NOT ISBLANK([Snapshot Metric]),[Snapshot Metric]-[Peer Benchmark])",
            "formatString": "+0.0;-0.0;0.0",
            "lineageTag": "b35c7607-72b9-41bd-bde7-dcd250a2847a"
          },
          {
            "name": "Country Rank",
            "displayFolder": "Ranking",
            "expression": "VAR V=[Snapshot Metric] VAR T=FILTER(ALLSELECTED(DimCountry[Country]),NOT ISBLANK(CALCULATE([Snapshot Metric]))) RETURN IF(NOT ISBLANK(V),IF([Metric Name]=\"Unemployment rate\",RANKX(T,[Snapshot Metric],,ASC,DENSE),RANKX(T,[Snapshot Metric],,DESC,DENSE)))",
            "formatString": "0",
            "lineageTag": "acb29a41-8f6d-4788-8fa4-bc63f97adf11"
          },
          {
            "name": "Top N Metric",
            "displayFolder": "Ranking",
            "expression": "IF([Country Rank]<=[Top N],[Snapshot Metric])",
            "formatString": "#,0.0",
            "lineageTag": "f0eedb72-dc1c-40cc-adcc-468be6568e11"
          },
          {
            "name": "Indexed Trend",
            "displayFolder": "Trends",
            "expression": "VAR B=CALCULATE([Selected Metric],REMOVEFILTERS(DimYear),DimYear[Year]=2000) RETURN IF(MAX(DimYear[Year])<=[Report Year],DIVIDE([Selected Metric],B)*100)",
            "formatString": "0.0",
            "lineageTag": "5a7915c8-3d00-4c5f-bff7-0bed939ab765"
          },
          {
            "name": "Metric Trend",
            "displayFolder": "Trends",
            "expression": "IF(MAX(DimYear[Year])<=[Report Year],[Selected Metric])",
            "formatString": "#,0.0",
            "lineageTag": "0a5dd965-0dcc-4495-b20f-5e54516c83b9"
          },
          {
            "name": "GDP CAGR Since 2000",
            "displayFolder": "Trends",
            "expression": "VAR Y=[Report Year] VAR B=CALCULATE([GDP PPP per Capita],REMOVEFILTERS(DimYear),DimYear[Year]=2000) RETURN IF(Y>2000 && B>0 && [Snapshot GDP]>0,POWER(DIVIDE([Snapshot GDP],B),1/(Y-2000))-1)",
            "formatString": "0.0%",
            "lineageTag": "fe17117f-26ff-4c8b-ac1d-a748f0161436"
          },
          {
            "name": "Reporting Countries",
            "displayFolder": "Data quality",
            "expression": "VAR Y=[Report Year] VAR R=CALCULATETABLE(FactDevelopment,REMOVEFILTERS(DimYear),DimYear[Year]=Y) RETURN COUNTROWS(FILTER(R,SWITCH([Metric Name],\"GDP PPP per capita\",NOT ISBLANK(FactDevelopment[GDPperCapitaPPP]),\"Unemployment rate\",NOT ISBLANK(FactDevelopment[UnemploymentPct]),NOT ISBLANK(FactDevelopment[LifeExpectancy]))))",
            "formatString": "0",
            "lineageTag": "a05ad5c4-9440-43f1-b676-b7920b077509"
          },
          {
            "name": "Country Coverage",
            "displayFolder": "Data quality",
            "expression": "DIVIDE([Reporting Countries],COUNTROWS(DimCountry))",
            "formatString": "0.0%",
            "lineageTag": "ad72210b-2f3b-4582-9a5f-5bd0001728a5"
          },
          {
            "name": "Missing Metric Rows",
            "displayFolder": "Data quality",
            "expression": "COUNTROWS(DimCountry)-[Reporting Countries]",
            "formatString": "0",
            "lineageTag": "186deb65-65e8-41b4-b2d1-685e9715e830"
          },
          {
            "name": "Duplicate Keys",
            "displayFolder": "Data quality",
            "expression": "COUNTROWS(FactDevelopment)-COUNTROWS(SUMMARIZE(FactDevelopment,FactDevelopment[ISO3],FactDevelopment[Year]))",
            "formatString": "0",
            "lineageTag": "17f13f47-f176-49dc-b395-b6632c3d2b12"
          },
          {
            "name": "Ranking Title",
            "displayFolder": "Narrative",
            "expression": "\"Top \" & FORMAT([Top N],\"0\") & \" countries | \" & [Metric Name] & \" | \" & FORMAT([Report Year],\"0\")",
            "formatString": "General",
            "lineageTag": "2085fa0f-5e5c-4df0-ad90-c9bb7b6ca72a"
          },
          {
            "name": "Context Caption",
            "displayFolder": "Narrative",
            "expression": "[Metric Name] & \" | \" & FORMAT([Report Year],\"0\") & \" | \" & FORMAT([Reporting Countries],\"0\") & \" reporting economies\"",
            "formatString": "General",
            "lineageTag": "a366aa9b-dffc-4057-bb6b-6b7f502f2065"
          },
          {
            "name": "Country Caption",
            "displayFolder": "Narrative",
            "expression": "SELECTEDVALUE(DimCountry[Country],\"Select one country or drill through from the ranking\")",
            "formatString": "General",
            "lineageTag": "27589a41-d0ab-4eb7-beba-8bc24e6b17eb"
          },
          {
            "name": "Refresh Mode",
            "displayFolder": "Data quality",
            "expression": "IF(COUNTROWS(RefreshInfo)>0,MAX(RefreshInfo[Mode]))",
            "formatString": "General",
            "lineageTag": "1afaef29-640e-4230-99a4-bc3bc2081fbe"
          }
        ],
        "partitions": [
          {
            "name": "FactDevelopment",
            "mode": "import",
            "source": {
              "expression": [
                "if UseLiveAPI then",
                "(let",
                " Codes={\"SP.POP.TOTL\",\"SP.DYN.LE00.IN\",\"NY.GDP.PCAP.PP.KD\",\"SL.UEM.TOTL.ZS\"},",
                " FetchIndicator=(code)=>let",
                "  Fetch=(p)=>Json.Document(Web.Contents(\"https://api.worldbank.org\",[RelativePath=\"v2/country/all/indicator/\"&code,Query=[format=\"json\",date=\"2000:2024\",per_page=\"20000\",page=Text.From(p)],Timeout=#duration(0,0,2,0)])),",
                "  First=Fetch(1), Rows=List.Combine(List.Transform({1..Number.From(First{0}[pages])},each if _=1 then First{1} else Fetch(_){1})),",
                "  T=Table.FromRecords(List.Transform(Rows,each [ISO3=_[countryiso3code],Year=Number.FromText(_[date]),Indicator=code,Value=_[value]]))",
                " in T,",
                " Tall=Table.Combine(List.Transform(Codes,each FetchIndicator(_))),",
                " Pivoted=Table.Pivot(Tall,Codes,\"Indicator\",\"Value\"),",
                " Names=Table.RenameColumns(Pivoted,{{\"SP.POP.TOTL\",\"Population\"},{\"SP.DYN.LE00.IN\",\"LifeExpectancy\"},{\"NY.GDP.PCAP.PP.KD\",\"GDPperCapitaPPP\"},{\"SL.UEM.TOTL.ZS\",\"UnemploymentPct\"}}),",
                " Clean=Table.SelectRows(Names,each List.Contains(DimCountry[ISO3],[ISO3])),",
                " Typed=Table.TransformColumnTypes(Clean,{{\"ISO3\",type text},{\"Year\",Int64.Type},{\"Population\",Int64.Type},{\"LifeExpectancy\",type number},{\"GDPperCapitaPPP\",type number},{\"UnemploymentPct\",type number}})",
                "in Typed)",
                "else",
                "(let",
                " Source=Csv.Document(Binary.FromText(\"\",BinaryEncoding.Base64),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Nulls=Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed=Table.TransformColumnTypes(Nulls,{{\"ISO3\",type text},{\"Year\",Int64.Type},{\"Population\",Int64.Type},{\"LifeExpectancy\",type number},{\"GDPperCapitaPPP\",type number},{\"UnemploymentPct\",type number}},\"en-US\")",
                "in Typed)"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}