if UseLiveAPI then
(let
 Fetch=(p)=>Json.Document(Web.Contents("https://api.worldbank.org",[RelativePath="v2/country",Query=[format="json",per_page="400",page=Text.From(p)],Timeout=#duration(0,0,2,0)])),
 First=Fetch(1), Rows=List.Combine(List.Transform({1..Number.From(First{0}[pages])},each if _=1 then First{1} else Fetch(_){1})),
 Clean=List.Select(Rows,each _[region][id]<>"NA"),
 T=Table.FromRecords(List.Transform(Clean,each [ISO3=_[id],Country=_[name],Region=_[region][value],IncomeGroup=_[incomeLevel][value],Latitude=try Number.FromText(_[latitude],"en-US") otherwise null,Longitude=try Number.FromText(_[longitude],"en-US") otherwise null]))
in T)
else
(let
 Source=Csv.Document(Binary.FromText("",BinaryEncoding.Base64),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
 Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
 Nulls=Table.ReplaceValue(Headers,"",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),
 Typed=Table.TransformColumnTypes(Nulls,{{"ISO3",type text},{"Country",type text},{"Region",type text},{"IncomeGroup",type text},{"Latitude",type number},{"Longitude",type number}},"en-US")
in Typed)